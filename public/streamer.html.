<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Go Live</title>
<style>
  body { margin: 0; font-family: Arial; background: #f4f4f4; text-align: center; }
  video { width: 100%; height: 55vh; background: black; }
  button {
    padding: 12px; width: 90%; margin: 10px;
    border: none; border-radius: 8px; font-weight: bold;
  }
  #start { background: green; color: white; }
  #stop { background: red; color: white; }
  #switchCam { background: #007bff; color: white; }
  #status { padding: 10px; background: white; }
</style>
</head>
<body>

<h2>🎥 Go Live</h2>
<video id="video" autoplay muted playsinline></video>
<div id="status">Ready...</div>
<button id="start">Start Stream</button>
<button id="stop" disabled>Stop Stream</button>
<button id="switchCam">Switch Camera</button>

<script src="https://sdk.videosdk.live/js-sdk/0.6.0/videosdk.js"></script>

<script type="module">
import { createClient } from "https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm";

const supabase = createClient(
  "https://eimecuiixwgmpfpedxpr.supabase.co",
  "sb_publishable_yFjk-cShSqVzlQye7DqRdg_F3AJ39ou"
);

const video = document.getElementById("video");
const status = document.getElementById("status");
const startBtn = document.getElementById("start");
const stopBtn = document.getElementById("stop");
const switchBtn = document.getElementById("switchCam");

let meeting = null;
let currentUserId = null;
let customTrack = null;
let currentFacing = "user";

// Attach video
function attachVideo(participant) {
  participant.on("stream-enabled", (stream) => {
    if (stream.kind === "video") {
      const ms = new MediaStream();
      ms.addTrack(stream.track);
      video.srcObject = ms;
      video.play();
      status.textContent = "🔴 LIVE";
    }
  });
}

// Get user
async function getUser() {
  const { data: { session } } = await supabase.auth.getSession();
  if (!session) throw new Error("Login required");
  return session.user.id;
}

// Switch camera
async function switchCamera() {
  if (!meeting) return;
  try {
    currentFacing = currentFacing === "user" ? "environment" : "user";
    status.textContent = `Switching to ${currentFacing}...`;

    if (customTrack) {
      await meeting.disableWebcam();
      customTrack.stop?.();
      customTrack.close?.();
    }

    customTrack = await VideoSDK.createCameraVideoTrack({
      facingMode: currentFacing
    });

    await meeting.enableWebcam(customTrack);
    attachVideo(meeting.localParticipant);

  } catch (err) {
    status.textContent = "❌ Camera error";
    console.error(err);
  }
}

switchBtn.onclick = switchCamera;

// START STREAM
startBtn.onclick = async () => {
  try {
    startBtn.disabled = true;
    status.textContent = "Authorizing...";

    const userId = await getUser();
    currentUserId = userId;

    const res = await fetch("https://scamming-lg3v.onrender.com/api/create-room", {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify({ userId })
    });

    const data = await res.json();
    if (!data.success) throw new Error("Room failed");

    await VideoSDK.config(data.hostToken);

    // 🔴 START RECORDING
    await fetch("/api/start-recording", {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify({ roomId: data.roomId })
    });

    customTrack = await VideoSDK.createCameraVideoTrack({ facingMode:"user" });

    meeting = VideoSDK.initMeeting({
      meetingId: data.roomId,
      name:"Host",
      participantId:userId,
      micEnabled:true,
      webcamEnabled:false
    });

    meeting.join();

    meeting.on("meeting-joined", async () => {
      stopBtn.disabled = false;

      while (!meeting.localParticipant) {
        await new Promise(r=>setTimeout(r,50));
      }

      await meeting.enableWebcam(customTrack);
      attachVideo(meeting.localParticipant);
    });

  } catch (err) {
    status.textContent = "❌ " + err.message;
    startBtn.disabled = false;
  }
};

// STOP STREAM + AUTO UPLOAD
stopBtn.onclick = async () => {
  try {
    status.textContent = "Stopping stream...";

    // 🔴 STOP RECORDING
    const res = await fetch("/api/stop-recording", {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify({ roomId: meeting.roomId })
    });

    const data = await res.json();

    if (!data.recordingUrl) {
      throw new Error("Recording not ready");
    }

    status.textContent = "Uploading video...";

    // DOWNLOAD VIDEO
    const videoRes = await fetch(data.recordingUrl);
    const blob = await videoRes.blob();

    // GET CLOUDINARY SIGNATURE
    const sig = await fetch("/api/video.js").then(r=>r.json());

    const formData = new FormData();
    formData.append("file", blob);
    formData.append("api_key", sig.apiKey);
    formData.append("timestamp", sig.timestamp);
    formData.append("signature", sig.signature);

    const uploadRes = await fetch(
      `https://api.cloudinary.com/v1_1/${sig.cloudName}/video/upload`,
      {
        method: "POST",
        body: formData
      }
    );

    const result = await uploadRes.json();

    // SAVE TO SUPABASE
    await supabase.from("posts").insert([{
      user_id: currentUserId,
      video_url: result.secure_url
    }]);

    status.textContent = "✅ Uploaded!";

    // CLEANUP
    meeting.leave();
    video.srcObject = null;
    startBtn.disabled = false;
    stopBtn.disabled = true;

  } catch (err) {
    console.error(err);
    status.textContent = "❌ " + err.message;
  }
};
</script>

</body>
  </html>
