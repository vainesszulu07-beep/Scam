

// --- REAL UI ELEMENTS ---
const video = document.getElementById("video");
const statusEl = document.getElementById("status");
const startBtn = document.getElementById("startBtn");
const stopBtn = document.getElementById("stopBtn");
const switchBtn = document.getElementById("switchBtn");
const muteBtn = document.getElementById("muteBtn");
const brbBtn = document.getElementById("brbBtn");
const brbOverlay = document.getElementById("brbOverlay");
const camListOverlay = document.getElementById("camListOverlay");
const camItemsContainer = document.getElementById("camItemsContainer");
const uploadProgressOverlay = document.getElementById("uploadProgressOverlay");
const progressPercent = document.getElementById("progressPercent");

// --- STATE ---
let meeting = null;
let currentUserId = null;
let videoTrack = null; 
let audioTrack = null;
let currentCameraId = null;
let isMicMuted = false;
let isVideoHidden = false;

// --- RECORDING STATE ---
let mediaRecorder = null;
let recordedChunks = [];
let segmentNumber = 1;
const sessionId = crypto.randomUUID();

// --- CAMERA UI INITIALIZATION ---
async function initCameraUI() {
    try {
        await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
        const devices = await navigator.mediaDevices.enumerateDevices();
        const cameras = devices.filter(d => d.kind === 'videoinput');
        
        camItemsContainer.innerHTML = '';
        cameras.forEach(cam => {
            const btn = document.createElement('button');
            btn.className = 'cam-item';
            btn.innerText = cam.label || `Camera ${cam.deviceId.slice(0,5)}...`;
            btn.onclick = () => {
                changeCamera(cam.deviceId);
                camListOverlay.style.display = 'none';
            };
            camItemsContainer.appendChild(btn);
        });
    } catch (e) {
        console.error("Camera perm error", e);
    }
}

window.onload = function() {
    if (window.VideoSDK) {
        statusEl.innerHTML = "<i class='ri-check-line'></i> SDK Ready";
        statusEl.className = "status-badge success";
        startBtn.disabled = false;
        initCameraUI();
    }
};

// --- USER AUTH ---
async function getUser() {
  const { data: { session } } = await supabase.auth.getSession();
  if (!session) throw new Error("Login required");
  return session.user.id;
}

// --- SMART MIRROR ---
function applySmartMirror(stream) {
  if (!stream) return;
  const track = stream.getVideoTracks()[0];
  const settings = track.getSettings();
  if (settings.facingMode === 'environment') {
    video.style.transform = "scaleX(1)";
  } else {
    video.style.transform = "scaleX(-1)";
  }
}

// --- RECORDING FUNCTIONS ---
function startRecording(stream) {
  recordedChunks = [];
  mediaRecorder = new MediaRecorder(stream);
  mediaRecorder.ondataavailable = e => {
    if (e.data.size > 0) recordedChunks.push(e.data);
  };
  mediaRecorder.start(2000);
}

async function stopAndUploadRecording(cameraId) {
  if (!mediaRecorder || mediaRecorder.state === "inactive") return;

  return new Promise(resolve => {
    mediaRecorder.onstop = async () => {
      if (recordedChunks.length > 0) {
        const blob = new Blob(recordedChunks, { type: "video/webm" });
        recordedChunks = [];
        
        uploadProgressOverlay.style.display = "flex";

        try {
          const { signature, timestamp, apiKey, cloudName } = await fetch("/api/video.js").then(r => r.json());

          const formData = new FormData();
          formData.append("file", blob, `camera-${cameraId}-segment.webm`);
          formData.append("api_key", apiKey);
          formData.append("timestamp", timestamp);
          formData.append("signature", signature);
          formData.append("folder", "videos");

          const xhr = new XMLHttpRequest();
          xhr.open("POST", `https://cloudinary.com{cloudName}/video/upload`);
          xhr.upload.onprogress = e => {
            if (e.lengthComputable) {
              progressPercent.textContent = Math.round((e.loaded / e.total) * 100) + "%";
            }
          };

          const uploadPromise = new Promise((res, rej) => {
            xhr.onload = () => {
              if (xhr.status >= 200 && xhr.status < 300) res(JSON.parse(xhr.responseText));
              else rej(new Error("Upload failed"));
            };
            xhr.onerror = () => rej(new Error("Upload error"));
            xhr.send(formData);
          });

          const videoData = await uploadPromise;

          await supabase.from("video_segments").insert([{
            session_id: sessionId,
            segment_number: segmentNumber++,
            camera_id: cameraId,
            user_id: currentUserId,
            video_url: videoData.secure_url,
            public_id: videoData.public_id
          }]);

        } catch (err) {
          console.error("Upload error:", err);
        } finally {
          uploadProgressOverlay.style.display = "none";
          resolve();
        }
      } else resolve();
    };
    mediaRecorder.stop();
  });
}

// --- STREAM FUNCTIONS ---
async function startStream() {
  try {
    startBtn.disabled = true;
    statusEl.innerHTML = "<i class='ri-loader-4-line'></i> Connecting...";
    
    const userId = await getUser();
    currentUserId = userId;

    const res = await fetch("https://onrender.com", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ userId })
    });
    const data = await res.json();
    
    window.VideoSDK.config(data.hostToken);

    videoTrack = await window.VideoSDK.createCameraVideoTrack({
      optimizationMode: "motion",
      encoderConfig: "h1080p_w1920p",
      facingMode: "user",
      multiStream: true
    });

    const settings = videoTrack.getVideoTracks()[0].getSettings();
    currentCameraId = settings.deviceId;

    audioTrack = await window.VideoSDK.createMicrophoneAudioTrack({
      encoderConfig: "high_quality", 
      noiseConfig: { noiseSuppression: true, echoCancellation: true, autoGainControl: true }
    });

    meeting = window.VideoSDK.initMeeting({
      meetingId: data.roomId,
      name: "Host",
      participantId: userId,
      micEnabled: true,
      webcamEnabled: true,
      customCameraVideoTrack: videoTrack,
      customMicrophoneAudioTrack: audioTrack
    });

    meeting.join();

    meeting.on("meeting-joined", async () => {
      statusEl.innerHTML = "<i class='ri-live-line'></i> LIVE";
      statusEl.className = "status-badge live";
      stopBtn.disabled = false;
      startBtn.style.display = 'none';
      switchBtn.style.display = 'inline-flex';
      muteBtn.style.display = 'inline-flex';
      brbBtn.style.display = 'inline-flex';

      video.srcObject = videoTrack;
      applySmartMirror(videoTrack);

      startRecording(videoTrack);

      await supabase.from("profile").update({
          is_live: true,
          stream_started_at: new Date().toISOString(),
          videosdk_room_id: data.roomId,
          videosdk_host_token: data.hostToken,
          videosdk_viewer_token: data.viewerToken, 
          stream_camera_on: true,
          stream_mic_on: true
      }).eq("id", userId);
    });

  } catch (err) {
    statusEl.textContent = "❌ " + err.message;
    startBtn.disabled = false;
  }
}

// --- MUTE / UNMUTE ---
async function toggleMute() {
    if (isMicMuted) {
        await meeting.unmuteMic();
        isMicMuted = false;
        muteBtn.innerHTML = "<i class='ri-mic-line'></i>";
        muteBtn.classList.remove('active');
    } else {
        await meeting.muteMic();
        isMicMuted = true;
        muteBtn.innerHTML = "<i class='ri-mic-off-line'></i>";
        muteBtn.classList.add('active');
    }
}

// --- BRB TOGGLE ---
async function toggleBRB() {
    if (isVideoHidden) {
        const newStream = await window.VideoSDK.createCameraVideoTrack({
            cameraId: currentCameraId,
            optimizationMode: "motion",
            encoderConfig: "h1080p_w1920p",
            multiStream: true
        });

        await meeting.enableWebcam(newStream);
        video.srcObject = newStream;
        applySmartMirror(newStream);
        videoTrack = newStream;
        startRecording(newStream);
        isVideoHidden = false;
        brbOverlay.style.display = "none";
        brbBtn.classList.remove('active');

    } else {
        await stopAndUploadRecording(currentCameraId);
        await meeting.disableWebcam();
        if (videoTrack) videoTrack.getTracks().forEach(t => t.stop());
        video.srcObject = null;
        isVideoHidden = true;
        brbOverlay.style.display = "flex";
        brbBtn.classList.add('active');
    }
}

// --- SWITCH CAMERA ---
async function changeCamera(selectedDeviceId) {
  const previousCameraId = currentCameraId;
  currentCameraId = selectedDeviceId;
  if (isVideoHidden) return; 

  try {
    await stopAndUploadRecording(previousCameraId);
    if (videoTrack) videoTrack.getTracks().forEach(track => track.stop());

    const newStream = await window.VideoSDK.createCameraVideoTrack({
      cameraId: selectedDeviceId, 
      optimizationMode: "motion",
      encoderConfig: "h1080p_w1920p",
      multiStream: true
    });

    await meeting.changeWebcam(newStream);
    video.srcObject = newStream;
    applySmartMirror(newStream); 
    videoTrack = newStream;
    startRecording(newStream);

  } catch (err) {
    statusEl.textContent = "❌ Switch Failed";
  }
}

// --- STOP STREAM ---
async function stopStream() {
  await stopAndUploadRecording(currentCameraId);

  if (meeting) meeting.leave();
  if (videoTrack) videoTrack.getTracks().forEach(t => t.stop());
  if (audioTrack) audioTrack.getTracks().forEach(t => t.stop());
  
  video.srcObject = null;
  statusEl.textContent = "🛑 Ended";
  statusEl.className = "status-badge";
  startBtn.style.display = 'inline-flex';
  startBtn.disabled = false;
  stopBtn.disabled = true;

  if (currentUserId) {
      await supabase.from("profile").update({
          is_live: false,
          stream_ended_at: new Date().toISOString(),
          videosdk_room_id: null
      }).eq("id", currentUserId);
  }

  fetch("/api/video_merge", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ session_id: sessionId, user_id: currentUserId })
  }).then(r => r.json()).then(console.log);
}

// --- BIND EVENTS ---
startBtn.onclick = startStream;
stopBtn.onclick = stopStream;
muteBtn.onclick = toggleMute;
brbBtn.onclick = toggleBRB;

switchBtn.onclick = (e) => {
    e.stopPropagation();
    camListOverlay.style.display = camListOverlay.style.display === 'flex' ? 'none' : 'flex';
};

document.addEventListener('click', (e) => {
    if (!switchBtn.contains(e.target) && !camListOverlay.contains(e.target)) {
        camListOverlay.style.display = 'none';
    }
});
