<!DOCTYPE html>  
<html lang="en">  
<head>  
    <meta charset="UTF-8">  
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">  
    <title>Molnia: Aero Sim</title>  

    
</head>  
<body>  
  
    <div id="game-container">  
        <div id="impact-flash"></div>  
          
        <div id="hud">  
            <h1 id="status">VECTOR LOCK</h1>  
            <div class="sub">TERRAIN: <span id="msg">TRACKING</span></div>  
        </div>  
  
        <div id="btn-left" class="control-btn">◄</div>  
        <div id="btn-right" class="control-btn">►</div>  
  
        <div id="canvas-target" style="width: 100%; height: 100%;"></div>  
    </div>  
  
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>  
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/FBXLoader.js"></script>  
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/libs/fflate.min.js"></script>  
  
    <script>  
        // --- SIMULATION SETTINGS ---  
        const CFG = {  
            speed: 1.8,             
            turnRate: 0.05,         
            bankLimit: 0.7,         
            trackWidth: 85,         
            hoverHeight: 4.5,     
            camDist: 35,            
            camHeight: 14,          
            lookAhead: 60,  
            scanRange: 250          
        };  
  
        // --- SETUP ---  
        const container = document.getElementById('canvas-target');  
        let width = container.clientWidth;  
        let height = container.clientHeight;  
  
        const scene = new THREE.Scene();  
        scene.fog = new THREE.FogExp2(0x000102, 0.0008);  
  
        const camera = new THREE.PerspectiveCamera(70, width / height, 0.1, 20000);  
        const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });  
        renderer.setSize(width, height);  
        renderer.toneMapping = THREE.ACESFilmicToneMapping;  
        container.appendChild(renderer.domElement);  
  
        // --- LIGHTS ---  
        const sun = new THREE.DirectionalLight(0xffffff, 1.5);  
        sun.position.set(0, 2000, 0);  
        scene.add(sun);  
        scene.add(new THREE.AmbientLight(0x4040ff, 0.6));  
        const shipLight = new THREE.PointLight(0x00ffcc, 3, 150);  
        scene.add(shipLight);  
  
        // --- TRACK GENERATION ---  
        const trackPoints = [];  
        const trackRes = 2500;   
          
        for (let i = 0; i <= trackRes; i++) {  
            const t = i / trackRes;   
            const angle = t * Math.PI * 2;  
              
            const x = Math.sin(angle) * 1600 + Math.cos(angle * 4) * 200;  
            const z = Math.cos(angle) * 1400 + Math.sin(angle * 3) * 300;  
              
            let y = 0;  
            if (t > 0.3 && t < 0.6) {  
                const localT = (t - 0.3) / 0.3;  
                y = Math.sin(localT * Math.PI) * 500;   
            }  
            else if (t > 0.8 && t < 0.9) {  
                const localT = (t - 0.8) / 0.1;  
                y = -Math.sin(localT * Math.PI) * 100;  
            }  
  
            trackPoints.push(new THREE.Vector3(x, y, z));  
        }  
  
        const trackCurve = new THREE.CatmullRomCurve3(trackPoints);  
        trackCurve.closed = true;  
  
        // Road  
        const roadGeo = new THREE.TubeGeometry(trackCurve, trackRes, CFG.trackWidth, 4, true);  
        roadGeo.scale(1, 0.05, 1);   
        const roadMat = new THREE.MeshStandardMaterial({ color: 0x0a0a0a, roughness: 0.3 });  
        const roadMesh = new THREE.Mesh(roadGeo, roadMat);  
        scene.add(roadMesh);  
  
        // Grid  
        const gridGeo = new THREE.TubeGeometry(trackCurve, trackRes, CFG.trackWidth, 2, true);  
        gridGeo.scale(1.01, 0.06, 1.01);  
        const gridMat = new THREE.MeshBasicMaterial({ color: 0x0088ff, wireframe: true, transparent: true, opacity: 0.4 });  
        scene.add(new THREE.Mesh(gridGeo, gridMat));  
  
        // Walls  
        const wallGeo = new THREE.TubeGeometry(trackCurve, trackRes, CFG.trackWidth + 5, 4, true);  
        wallGeo.scale(1, 0.6, 1);   
        const wallMat = new THREE.MeshBasicMaterial({ color: 0x00ffcc, wireframe: true, transparent: true, opacity: 0.2 });  
        scene.add(new THREE.Mesh(wallGeo, wallMat));  
  
        // PLAYER  
        const shipRoot = new THREE.Object3D();   
        const shipTilt = new THREE.Object3D();   
        const modelZone = new THREE.Object3D();   
          
        scene.add(shipRoot);  
        shipRoot.add(shipTilt);  
        shipTilt.add(modelZone);  
  
        const startPt = trackCurve.getPointAt(0);  
        const startLook = trackCurve.getPointAt(0.01);  
        shipRoot.position.copy(startPt);  
        shipRoot.position.y += 10;  
        shipRoot.lookAt(startLook);  
  
        const loader = new THREE.FBXLoader();  
        loader.load('molnia.fbx', (obj) => {  
            obj.scale.set(3.5, 3.5, 3.5);   
            obj.rotation.set(  
                THREE.MathUtils.degToRad(90),  
                THREE.MathUtils.degToRad(180),  
                0  
            );  
            obj.position.y = 1.5;  
            modelZone.add(obj);  
        });  
  
        // CONTROLS  
        let input = 0;  
        const bind = (id, val) => {  
            const el = document.getElementById(id);  
            const start = (e) => { e.preventDefault(); input = val; };  
            const end = (e) => { e.preventDefault(); input = 0; };  
            el.addEventListener('touchstart', start);  
            el.addEventListener('mousedown', start);  
            el.addEventListener('touchend', end);  
            el.addEventListener('mouseup', end);  
        };  
        bind('btn-left', 1);     
        bind('btn-right', -1);   
          
        window.addEventListener('keydown', (e) => {  
            if(e.key === 'ArrowLeft') input = 1;  
            if(e.key === 'ArrowRight') input = -1;  
        });  
        window.addEventListener('keyup', () => input = 0);  
  
        // PHYSICS  
        let currentSpeed = 0;  
        let bankAngle = 0;  
        let lastTrackIdx = 0;  
  
        const raycaster = new THREE.Raycaster();  
        const downVector = new THREE.Vector3(0, -1, 0);  
        const vecPos = new THREE.Vector3();  
        const vecTarget = new THREE.Vector3();  
  
        function updatePhysics() {  
            if(currentSpeed < CFG.speed) currentSpeed += 0.03;  
  
            shipRoot.rotateY(input * CFG.turnRate);  
  
            const forward = new THREE.Vector3(0, 0, 1).applyQuaternion(shipRoot.quaternion);  
            const flatForward = new THREE.Vector3(forward.x, 0, forward.z).normalize();  
            shipRoot.position.add(flatForward.multiplyScalar(currentSpeed));  
  
            alignToTerrain();  
  
            const targetBank = input * CFG.bankLimit;  
            bankAngle = THREE.MathUtils.lerp(bankAngle, targetBank, 0.1);  
            shipTilt.rotation.z = bankAngle;  
  
            solveWalls();  
        }  
  
        function alignToTerrain() {  
            const rayOrigin = shipRoot.position.clone();  
            rayOrigin.y += 150;  
            raycaster.set(rayOrigin, downVector);  
            const hitsA = raycaster.intersectObject(roadMesh);  
  
            let groundY = shipRoot.position.y;  
            let hasGround = false;  
  
            if (hitsA.length > 0) {  
                groundY = hitsA[0].point.y + CFG.hoverHeight;  
                hasGround = true;  
            }  
  
            if (hasGround) {  
                shipRoot.position.y = THREE.MathUtils.lerp(shipRoot.position.y, groundY, 0.25);  
            }  
        }  
  
        function solveWalls() {  
            let bestDist = Infinity;  
            let bestPt = null;  
            let bestIdx = lastTrackIdx;  
  
            for(let i = -CFG.scanRange; i < CFG.scanRange; i++) {  
                let idx = (lastTrackIdx + i + trackRes) % trackRes;  
                const pt = trackCurve.getPointAt(idx / trackRes);  
                const dist = new THREE.Vector2(shipRoot.position.x, shipRoot.position.z).distanceToSquared(new THREE.Vector2(pt.x, pt.z));  
                if (dist < bestDist) { bestDist = dist; bestPt = pt; bestIdx = idx; }  
            }  
  
            if (bestPt) {  
                lastTrackIdx = bestIdx;  
                const realDist = Math.sqrt(bestDist);  
                  
                if (realDist > CFG.trackWidth) {  
                    currentSpeed *= 0.85;  
                }  
            }  
        }  
  
        function animate() {  
            requestAnimationFrame(animate);  
            updatePhysics();  
  
            const offset = new THREE.Vector3(0, CFG.camHeight, -CFG.camDist);  
            offset.applyQuaternion(shipRoot.quaternion);  
            const targetPos = new THREE.Vector3().copy(shipRoot.position).add(offset);  
              
            camera.position.lerp(targetPos, 0.15);  
              
            const forward = new THREE.Vector3(0, 0, 100).applyQuaternion(shipRoot.quaternion);  
            const lookTarget = shipRoot.position.clone().add(forward);  
            camera.lookAt(lookTarget);  
  
            shipLight.position.copy(shipRoot.position);  
  
            renderer.render(scene, camera);  
        }  
  
        animate();  
  
        window.addEventListener('resize', () => {  
            const w = container.clientWidth;  
            const h = container.clientHeight;  
            camera.aspect = w/h;  
            camera.updateProjectionMatrix();  
            renderer.setSize(w, h);  
        });  
  
    </script>  
</body>  
</html>
